n\n@keyframes lumin-shimmer {\n  0% { background-position: 200% 0; }\n  100% { background-position: -200% 0; }\n}\n\n.lumin-pagination {\n  display: flex;\n  justify-content: center;\n  gap: 8px;\n  margin-top: 20px;\n}\n\n.lumin-page-btn {\n  padding: 6px 14px;\n  background: var(--lumin-surface);\n  border: 1px solid var(--lumin-border);\n  border-radius: 6px;\n  color: var(--lumin-text);\n  font-size: 13px;\n  cursor: pointer;\n}\n.lumin-page-btn:hover, .lumin-page-btn.active {\n  background: var(--lumin-accent);\n  color: #fff;\n  border-color: var(--lumin-accent);\n}\n.lumin-page-btn:disabled {\n  opacity: 0.4;\n  cursor: default;\n}\n\n.lumin-empty {\n  text-align: center;\n  padding: 40px 20px;\n  color: var(--lumin-text-secondary);\n  font-size: 14px;\n}\ngameslumin-gridonReadygetValueapply--lumin-input-borderautoplay; fullscreen; pointer-lock; gamepaddeagershowremoveChildcontentWindowpx;left:0;right:0;#818cf8lumin-catiterator result is not an objectmsgIdaddgameonChange#6366f1_invoke#d0d0d0inputopenFETCH_RANDOMMapURLunmounttoUpperCaselink[data-lumin-preconnect]src#1a1a1areturngetGameUrlheightspanheadparseeagerCountGeneratortoStringTagreadyCannot call a class as a functiondivdns-prefetchframe-ok\\/+$wFETCH_GAMESwindow.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag(\"js\",new Date());gtag(\"config\",\"G-L69H1VNZ27\");allnext#f0f0f0#222endGamedata-lumin-preconnectlumin-page-btnlumin-flyout-visiblebuttonerror,60%,70%)\"\u003eluminWorkerprobeUrlrenderdonebodyhrefgameIdFETCH_CATEGORIEScurrentPagefunctionclassNamecreateDocumentFragmentasyncaddEventListener/api/v1/icon/jpagesloadGame--lumin-columnsClose gameurl_apiBasemodeinitializedContainer not found: rejectgetOwnPropertyDescriptorcssTextdomain fetch failedmprototypesetPropertyallowfullscreenclosepostMessageJSONstartrevokeObjectURL,45%,25%)\"/\u003e\u003ctext x=\"100\" y=\"116\" text-anchor=\"middle\" font-family=\"system-ui,sans-serif\" font-size=\"96\" font-weight=\"700\" fill=\"h